{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/node_modules/**"
  ],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "react/rules-of-hooks": "error",
    "eslint/curly": "error",
    "eslint/max-params": [
      "error",
      {
        "max": 4
      }
    ],
    "eslint/no-else-return": "error",
    "eslint/no-negated-condition": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-shadow": "error",
    "unicorn/numeric-separators-style": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/desktop/src/renderer/src/**",
        "apps/desktop/harness/main.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The renderer reaches main only through the bridge (app.api)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@repo/engine",
                  "@repo/engine/*",
                  "@repo/release",
                  "@repo/core/store",
                  "@repo/core/host",
                  "@repo/core/secret-store",
                  "@repo/core/fs",
                  "@repo/core/helper-crypto",
                  "@repo/vpns/engine",
                  "@repo/vpn-sdk/engine",
                  "@repo/vpn-sdk/container"
                ],
                "message": "Node-only packages stay in main."
              }
            ]
          }
        ],
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/**"
      ],
      "rules": {
        "import/no-nodejs-modules": "error",
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "fs",
                  "fs/*",
                  "path",
                  "os",
                  "child_process",
                  "net",
                  "crypto",
                  "stream",
                  "http",
                  "https",
                  "url",
                  "util",
                  "events",
                  "buffer",
                  "worker_threads"
                ],
                "message": "The design kit runs in the sandboxed window: no Node."
              },
              {
                "group": [
                  "@repo/*"
                ],
                "message": "@repo/ui is the design kit: it knows nothing about the app or VPNs (see docs/code-structure.md)."
              }
            ],
            "paths": [
              {
                "name": "electron",
                "message": "The renderer reaches main only through the bridge (app.api)."
              }
            ]
          }
        ]
      }
    },
